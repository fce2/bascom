10 REM *** LADDER ***
11 REM CLIMB 7 ZIG-ZAG PLATFORMS TO THE GOAL WHILE BARRELS ROLL DOWN.
12 REM A/D=LEFT/RIGHT (OR CRSR)  W/S=UP/DOWN (OR CRSR)  Q=QUIT.
13 REM MIX OF JUMPMAN / LODE RUNNER / DONKEY KONG.  COMPILED BY bascom.
14 REM DOCUMENTED DIVERGENCE: REAL-TIME KBD + RND => COMPILED VS
15 REM INTERPRETER SCREENS DIVERGE.  NOT A COMPT TEST BUG.
20 PRINT CHR$(147)
25 POKE 53280,0:POKE 53281,0
30 FL%=160:LD%=8:PL%=81:BR%=15:GL%=16:EM%=32
35 GX%=36:GY%=4
36 DIM MP%(999):DIM RX%(3):DIM RY%(3):DIM VX%(3):DIM VY%(3):DIM RD%(3):DIM BF%(3):DIM RS%(3):DIM D%(4)
40 GOSUB 8000
42 GOSUB 8300
50 LF%=3:LV%=1:SC%=0:GG%=0:WN%=0:BS%=30:HD%=1:DD%=1:CL%=0
55 GOSUB 7000
60 GOSUB 6100
70 REM ===== MAIN LOOP =====
80 WAIT 53265,128:WAIT 53265,128,128
85 K%=PEEK(197):POKE 198,0:SF%=PEEK(653) AND 1
86 IF K%<>64 THEN DM%=0
87 IF DM%=1 THEN GOSUB 5500
88 IF K%=7 THEN IF SF% THEN K%=9
89 IF K%=7 THEN IF SF%=0 THEN K%=13
90 IF K%=2 THEN IF SF%=0 THEN K%=18
91 IF K%=2 THEN IF SF% THEN K%=10
92 IF K%=62 THEN GOTO 9500
100 GOSUB 5000
105 IF PX%=GX% THEN IF PY%=GY% THEN GOSUB 3200:GOTO 80
110 GOSUB 2000
120 GOSUB 3000
130 GOSUB 4000
135 IF HD%=1 THEN HD%=0:GOSUB 7100
150 IF GG%=1 THEN GOTO 8500
160 GOTO 80

2000 REM BARREL TICK + SPAWN
2005 BP%=BP%+1
2008 IF BP%>=BS% THEN BP%=0:GOSUB 2100
2010 FOR I=0 TO 3
2012 IF BF%(I)=0 THEN 2090
2015 GOSUB 2200
2090 NEXT I
2095 RETURN

2100 REM SPAWN ONE BARREL IF A SLOT IS FREE (VARIABLE-INDEX READ)
2105 SI%=-1
2107 FOR J=0 TO 3
2108 IF SI%<0 THEN IF BF%(J)=0 THEN SI%=J
2109 NEXT J
2130 IF SI%<0 THEN RETURN
2135 RX%(SI%)=2:RY%(SI%)=4:RD%(SI%)=1:BF%(SI%)=1:RS%(SI%)=0
2140 RETURN

2200 REM MOVE ONE BARREL I: ROLL OR FALL (NO FOR)
2205 VX%(I)=RX%(I):VY%(I)=RY%(I)
2210 IF RS%(I)=1 THEN GOTO 2300
2220 RX%(I)=RX%(I)+RD%(I)
2225 IF RX%(I)<1 THEN RX%(I)=1:RS%(I)=1:GOTO 2290
2230 IF RX%(I)>38 THEN RX%(I)=38:RS%(I)=1:GOTO 2290
2290 RETURN

2300 REM BARREL I FALLING: DROP ONE ROW, LAND/REVERSE OR DESPAWN (NO FOR)
2305 RY%(I)=RY%(I)+1
2306 IF RY%(I)>24 THEN BF%(I)=0:RETURN
2310 IF MP%(RY%(I)*40+RX%(I))=1 THEN RS%(I)=0:RD%(I)=0-RD%(I):RETURN
2315 RETURN

3000 REM COLLISION: BARRELS VS PLAYER (FOR, FROM MAIN LOOP)
3005 IF IV%>0 THEN RETURN
3010 FOR I=0 TO 3
3015 IF BF%(I)=0 THEN 3030
3020 IF RX%(I)=PX% THEN IF RY%(I)=PY% THEN GOSUB 3100
3030 NEXT I
3035 RETURN

3100 REM HIT: LOSE LIFE, ERASE PLAYER AT HIT CELL, INVULN, RESET POS (NO FOR)
3105 LF%=LF%-1:IV%=40:HD%=1
3107 T%=MP%(PY%*40+PX%):GOSUB 5900:POKE 1024+PY%*40+PX%,TG%:POKE 55296+PY%*40+PX%,TC%
3110 IF LF%<=0 THEN GG%=1:RETURN
3115 PX%=20:PY%=22:OX%=20:OY%=22:DD%=1:CL%=0
3120 RETURN

3200 REM LEVEL COMPLETE: SCORE, SPEED UP, RESET ROUND (NO FOR)
3205 SC%=SC%+100:LV%=LV%+1:HD%=1
3210 BS%=BS%-4:IF BS%<10 THEN BS%=10
3215 GOSUB 6100
3220 RETURN

4000 REM RENDER BARRELS: ERASE OLD CELL, DRAW NEW (FOR, FROM MAIN LOOP)
4005 FOR I=0 TO 3
4010 IF BF%(I)=0 THEN 4040
4015 T%=MP%(VY%(I)*40+VX%(I)):GOSUB 5900:POKE 1024+VY%(I)*40+VX%(I),TG%:POKE 55296+VY%(I)*40+VX%(I),TC%
4020 POKE 1024+RY%(I)*40+RX%(I),BR%:POKE 55296+RY%(I)*40+RX%(I),8
4040 NEXT I
4045 RETURN

5000 REM INPUT + MOVE + DRAW PLAYER (NO FOR)
5005 T%=MP%(OY%*40+OX%):GOSUB 5900:POKE 1024+OY%*40+OX%,TG%:POKE 55296+OY%*40+OX%,TC%
5008 NX%=PX%:NY%=PY%
5010 IF K%=10 THEN GOSUB 5100
5015 IF K%=18 THEN GOSUB 5150
5020 IF K%=9 THEN GOSUB 5200
5025 IF K%=13 THEN GOSUB 5300
5030 PX%=NX%:PY%=NY%:OX%=PX%:OY%=PY%
5035 GOSUB 5400
5040 RETURN

5100 REM MOVE LEFT
5105 IF NX%>0 THEN IF MP%(NY%*40+NX%-1)=1 OR MP%(NY%*40+NX%-1)=3 THEN NX%=NX%-1
5110 RETURN

5150 REM MOVE RIGHT
5155 IF NX%<39 THEN IF MP%(NY%*40+NX%+1)=1 OR MP%(NY%*40+NX%+1)=3 THEN NX%=NX%+1
5160 RETURN

5200 REM MOVE UP: LADDER, OR EXIT LADDER ONTO FLOOR/GOAL
5205 IF NY%<1 THEN RETURN
5210 TC%=MP%((NY%-1)*40+NX%)
5215 IF TC%=2 THEN NY%=NY%-1:RETURN
5220 IF TC%=1 THEN IF MP%(NY%*40+NX%)=2 THEN NY%=NY%-1:RETURN
5225 IF TC%=3 THEN IF MP%(NY%*40+NX%)=2 THEN NY%=NY%-1:RETURN
5230 RETURN

5300 REM MOVE DOWN: LADDER, OR EXIT LADDER ONTO FLOOR/GOAL
5305 IF NY%>23 THEN RETURN
5310 TC%=MP%((NY%+1)*40+NX%)
5315 IF TC%=2 THEN NY%=NY%+1:RETURN
5320 IF TC%=1 THEN IF MP%(NY%*40+NX%)=2 THEN NY%=NY%+1:RETURN
5325 IF TC%=3 THEN IF MP%(NY%*40+NX%)=2 THEN NY%=NY%+1:RETURN
5330 RETURN

5400 REM DRAW PLAYER (INVULN -> RED)
5405 IF IV%>0 THEN IV%=IV%-1
5410 PC%=7:IF IV%>0 THEN PC%=2
5415 POKE 1024+PY%*40+PX%,PL%:POKE 55296+PY%*40+PX%,PC%
5420 RETURN
5500 REM DEMO AI -> K$ (attract: zig-zag climb, flip dir each ladder)
5505 K%=64
5506 IF RND(1)<0.08 THEN RETURN
5510 IF PY%<=GY% THEN 5570
5515 TC%=MP%(PY%*40+PX%)
5520 IF TC%=2 THEN K%=9:RETURN
5525 UD%=MP%((PY%-1)*40+PX%):IF UD%=2 THEN K%=9:RETURN
5530 REM SEEK NEAREST COLUMN WITH A LADDER ABOVE -> CLIMB UP
5532 ZA%=99:ZC%=-1
5534 FOR J=1 TO 38
5535 IF MP%((PY%-1)*40+J)=2 THEN ZD%=ABS(J-PX%):IF ZD%<ZA% THEN ZA%=ZD%:ZC%=J
5536 NEXT J
5538 IF ZC%<0 THEN K%=18:RETURN
5539 IF PX%<ZC% THEN K%=18:RETURN
5540 IF PX%>ZC% THEN K%=10:RETURN
5542 RETURN
5570 IF PX%<GX% THEN K%=18:RETURN
5575 IF PX%>GX% THEN K%=10:RETURN
5580 RETURN

5900 REM TILE GLYPH+COLOR: T% -> TG%,TC% (NO FOR)
5905 TG%=EM%:TC%=0
5910 IF T%=1 THEN TG%=FL%:TC%=6
5915 IF T%=2 THEN TG%=LD%:TC%=5
5920 IF T%=3 THEN TG%=GL%:TC%=2
5925 RETURN

6100 REM RESET ROUND: CLEAR BARRELS, RESET PLAYER, REDRAW TILES
6105 FOR I=0 TO 3:BF%(I)=0:NEXT I
6110 PX%=20:PY%=22:OX%=20:OY%=22:IV%=0:BP%=0:DD%=1-2*INT(RND(1)*2):CL%=0
6115 GOSUB 9000
6118 GOSUB 8400
6120 RETURN

7000 REM HUD LABELS (NO FOR)
7005 T$="SCORE":TX%=0:TY%=0:GOSUB 7500
7010 T$="LIVES":TX%=12:TY%=0:GOSUB 7500
7015 T$="LEVEL":TX%=20:TY%=0:GOSUB 7500
7020 REM
7025 GOSUB 7100
7030 RETURN

7100 REM HUD DIGITS: SCORE LIVES LEVEL (FOR, FROM MAIN LOOP / 7000)
7105 T%=SC%:FOR J=0 TO 4:D%(J)=T%-10*INT(T%/10):T%=INT(T%/10):NEXT J
7110 POKE 1030,48+D%(4):POKE 1031,48+D%(3):POKE 1032,48+D%(2)
7112 POKE 1033,48+D%(1):POKE 1034,48+D%(0)
7115 POKE 1042,48+LF%
7120 POKE 1050,48+INT(LV%/10):POKE 1051,48+LV%-10*INT(LV%/10)
7122 IF DM%=1 THEN POKE 1060,4:POKE 1061,5:POKE 1062,13:POKE 1063,15:POKE 55332,7:POKE 55333,7:POKE 55334,7:POKE 55335,7
7124 IF DM%=0 THEN POKE 1060,32:POKE 1061,32:POKE 1062,32:POKE 1063,32:POKE 55332,0:POKE 55333,0:POKE 55334,0:POKE 55335,0
7125 RETURN

7500 REM POKE STRING T$ AT (TX%,TY%) AS SCREEN CODES (FOR, FROM 7000)
7505 FOR I=1 TO LEN(T$)
7510 CH%=ASC(MID$(T$,I,1))
7515 IF CH%>=64 THEN IF CH%<=95 THEN CH%=CH%-64
7520 POKE 1024+TX%+I-1+TY%*40,CH%
7525 NEXT I
7530 RETURN

8000 REM BUILD MAP FROM DATA: PLATFORMS + LADDERS + GOAL, THEN DRAW
8005 FOR I=0 TO 999:MP%(I)=0:NEXT I
8010 FOR P=0 TO 6:READ PR%:FOR C=1 TO 38:MP%(PR%*40+C)=1:NEXT C:NEXT P
8020 FOR L=0 TO 11:READ LX%:READ LT%:READ LB%:FOR R=LT% TO LB%:MP%(R*40+LX%)=2:NEXT R:NEXT L
8030 MP%(GY%*40+GX%)=3
8040 GOSUB 9000
8045 RETURN
8050 DATA 22,19,16,13,10,7,4
8060 DATA 8,5,6
8065 DATA 30,5,6
8070 DATA 12,8,9
8075 DATA 28,8,9
8080 DATA 8,11,12
8085 DATA 30,11,12
8090 DATA 12,14,15
8095 DATA 28,14,15
8100 DATA 8,17,18
8105 DATA 30,17,18
8110 DATA 12,20,21
8115 DATA 28,20,21

8300 REM TITLE SCREEN
8305 PRINT CHR$(147)
8310 T$="LADDER":TX%=17:TY%=0:GOSUB 7500
8315 T$="W/A/S/D OR CRSR TO MOVE":TX%=8:TY%=2:GOSUB 7500
8320 T$="CLIMB TO GOAL  AVOID BARRELS":TX%=6:TY%=3:GOSUB 7500
8325 T$="Q=QUIT":TX%=8:TY%=4:GOSUB 7500
8330 T$="SPACE TO PLAY  D=DEMO":TX%=8:TY%=5:GOSUB 7500
8335 FOR GD%=1 TO 200
8337 WAIT 53265,128:WAIT 53265,128,128
8340 GET K$
8345 IF K$="D" THEN DM%=1:GOTO 8390
8350 IF K$<>"" THEN DM%=0:GOTO 8390
8355 NEXT GD%
8360 DM%=1
8390 PRINT CHR$(147)
8395 RETURN
8400 REM GET READY PAUSE
8405 T$="GET READY":TX%=16:TY%=12:GOSUB 7500
8410 FOR GD%=1 TO 90
8412 WAIT 53265,128:WAIT 53265,128,128
8415 NEXT GD%
8418 GOSUB 9000
8420 RETURN

8500 REM GAME OVER
8505 PRINT CHR$(147)
8510 PRINT:PRINT "  *** GAME OVER ***"
8515 PRINT:PRINT "  SCORE:";SC%
8520 PRINT "  LEVEL:";LV%
8525 PRINT:PRINT "  R=RESTART  Q=QUIT"
8530 IF DM%=1 THEN 8550
8532 GET K$:IF K$="" THEN 8532
8535 IF K$="R" THEN GOTO 50
8540 IF K$="Q" THEN GOTO 9500
8545 GOTO 8530
8550 FOR J=1 TO 1500:NEXT J:GOTO 50

9000 REM DRAW ALL TILES FROM MP% (NESTED FOR; CALLED ONLY AFTER CALLER FORS DONE)
9005 FOR I=1 TO 24:FOR J=0 TO 39
9010 T%=MP%(I*40+J):GOSUB 5900
9015 POKE 1024+I*40+J,TG%
9020 CC%=0:IF T%=1 THEN CC%=6
9025 IF T%=2 THEN CC%=5
9030 IF T%=3 THEN CC%=2
9035 POKE 55296+I*40+J,CC%
9040 NEXT J:NEXT I
9045 RETURN

9500 REM QUIT
9505 PRINT CHR$(147):END