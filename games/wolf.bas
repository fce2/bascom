10 REM *** WOLF *** PURE-BASCOM FIXED-POINT RAYCASTER (NO ML, NO SYS)
20 REM WASD MOVE/AIM, Q QUIT.  ALL-INTEGER 8.8 FIXED POINT - NO FLOAT,
30 REM NO FDIV -> BYPASSES THE FLOAT CODEGEN BUG AND IS FAST.
40 REM ASM REF: WOLF_DDA.S (KEPT).  DDA WALK PORTED TO INT RAYMARCH.
50 poke 650,128
60 POKE 53280,0:POKE 53281,0:PRINT CHR$(147)
70 FOR I=1064 TO 1983:POKE I,35:NEXT I
80 DIM SI%(255),M%(255),OF%(19),LP%(39),LB%(39),LW%(39),LH%(39)
90 GOSUB 1700:GOSUB 1800:GOSUB 1900
100 FOR I=0 TO 39:LH%(I)=-1:NEXT I
110 GOSUB 2100
120 X%=384:Y%=384:PA%=0:LV%=1:ST%=0:WN%=0:LT%=PEEK(162):FA%=0:FPS%=0:FOR I=0 TO 39:LH%(I)=-1:NEXT I
130 GOSUB 1000:GOSUB 2000
140 K%=PEEK(197):POKE 198,0:MV%=0:MF%=0
150 IF DM%=1 AND K%<>64 THEN DM%=0
160 IF DM%=1 THEN GOSUB 2200
170 IF K%=62 THEN GOTO 2116
180 IF K%=17 THEN GOTO 110
190 IF K%=10 THEN PA%=(PA%-2) AND 255:MV%=1
200 IF K%=18 THEN PA%=(PA%+2) AND 255:MV%=1
210 IF K%=9 THEN GOSUB 1100:MF%=1:MV%=1
220 IF K%=13 THEN GOSUB 1200:MF%=1:MV%=1
230 IF MV%=1 THEN GOSUB 1000
240 GOSUB 2000
250 WAIT 53265,128
260 IF MF%=1 THEN HP%=HP%-1:ST%=ST%+1
270 CX%=INT(X%/256):CY%=INT(Y%/256):IF M%(CY%*16+CX%)=4 THEN WN%=1:GOTO 2116
280 IF HP%<=0 THEN WN%=0:GOTO 2116
290 FC%=FC%+1
295 T%=PEEK(162):IF T%=LT% THEN 300
296 D%=T%-LT%:IF D%<0 THEN D%=D%+256
297 IF D%<30 THEN 300
298 FPS%=INT(((FC%-FA%)*60)/D%):FA%=FC%:LT%=T%
300 GOTO 140

1000 REM === RENDER: 20 RAYS, DUAL-COLUMN, 8.8 FIXED RAYMARCH ===
1001 FOR K=0 TO 9
1002 RI%=(PA%+OF%(K)) AND 255
1003 DX%=SI%((RI%+64) AND 255):DY%=SI%(RI%)
1004 RX%=X%:RY%=Y%:SD%=0:TW%=0
1005 FOR S=1 TO 80
1006 OX%=INT(RX%/256):OY%=INT(RY%/256)
1007 RX%=RX%+DX%:RY%=RY%+DY%
1008 NX%=INT(RX%/256):NY%=INT(RY%/256)
1009 IF NX%=OX% AND NY%=OY% THEN 1018
1010 IF NX%<0 THEN 1019
1011 IF NX%>15 THEN 1019
1012 IF NY%<0 THEN 1019
1013 IF NY%>15 THEN 1019
1014 TW%=M%(NY%*16+NX%)
1015 IF NX%<>OX% THEN SD%=0
1016 IF NY%<>OY% THEN SD%=1
1017 IF TW%<>0 THEN 1019
1018 NEXT S
1019 IF S>80 THEN HT%=0:GOTO 1024
1020 HT%=44/S
1021 IF HT%>12 THEN HT%=12
1022 IF HT%<1 THEN HT%=1
1023 GOSUB 1400
1024 C1%=K*4:SW%=WC%
1025 IF K>0 THEN IF TW%<>PTW% OR SD%<>PSD% THEN WC%=EC%
1026 GOSUB 1500
1027 WC%=SW%:C1%=C1%+1:GOSUB 1500
1028 C1%=C1%+1:GOSUB 1500
1029 C1%=C1%+1:GOSUB 1500
1030 PTW%=TW%:PSD%=SD%:NEXT K
1031 RETURN

1100 REM MOVE FORWARD (0.125 CELL, 50% STEP)
1101 DX%=SI%((PA%+64) AND 255):DY%=SI%(PA%)
1102 NX%=X%+DX%/4:NY%=Y%+DY%/4
1103 GOSUB 1300:IF OK% THEN X%=NX%:Y%=NY%
1104 RETURN

1200 REM MOVE BACK (0.125 CELL, 50% STEP)
1201 DX%=SI%((PA%+64) AND 255):DY%=SI%(PA%)
1202 NX%=X%-DX%/4:NY%=Y%-DY%/4
1203 GOSUB 1300:IF OK% THEN X%=NX%:Y%=NY%
1204 RETURN

1300 REM COLLISION: NX%,NY% -> OK%
1301 CX%=INT(NX%/256):CY%=INT(NY%/256):OK%=0
1302 IF CX%<0 THEN RETURN
1303 IF CX%>15 THEN RETURN
1304 IF CY%<0 THEN RETURN
1305 IF CY%>15 THEN RETURN
1306 IF M%(CY%*16+CX%)<>0 AND M%(CY%*16+CX%)<>4 THEN RETURN
1307 OK%=1:RETURN

1400 REM WALL COLOR WC%, EDGE EC%, GLYPH WG% FROM TW%, SD%, S
1401 WG%=35
1402 IF TW%=4 THEN WC%=7:WG%=24:IF SD%=1 THEN WC%=13:GOTO 1406
1403 IF TW%=1 THEN WC%=15:WG%=35:IF SD%=1 THEN WC%=11
1404 IF TW%=2 THEN WC%=10:WG%=61:IF SD%=1 THEN WC%=2
1405 IF TW%=3 THEN WC%=14:WG%=42:IF SD%=1 THEN WC%=6
1406 IF S>40 THEN WC%=11:WG%=58
1407 EC%=WC%
1408 IF WC%=15 THEN EC%=11
1409 IF WC%=14 THEN EC%=6
1410 IF WC%=13 THEN EC%=5
1411 IF WC%=12 THEN EC%=11
1412 IF WC%=10 THEN EC%=2
1413 IF WC%=7 THEN EC%=8
1414 RETURN

1500 REM DELTA-DRAW COL C1%: color+char, TP/BT, hoist LP/LB->OP/OB
1501 CB%=55296+C1%:J%=C1%
1502 IF LH%(J%)<0 THEN 1614
1503 OP%=LP%(J%):OB%=LB%(J%):OC%=LW%(J%)
1504 TT%=12-INT(HT%/2):TP%=TT%:BT%=TT%+HT%-1
1505 IF TP%<6 THEN TP%=6
1506 IF BT%>17 THEN BT%=17
1507 IF TP%>BT THEN TP%=BT
1508 TR%=TP%:BR%=BT%
1509 IF TR%=OP% AND BR%=OB% AND WC%=OC% THEN 1519
1510 IF WC%<>OC% THEN CH%=WG%:A%=TR%:B%=BR%:CO%=WC%:GOSUB 1600
1511 IF TR%=OP% THEN 1515
1512 IF TR%>OP% THEN 1514
1513 CH%=WG%:A%=TR%:B%=OP%-1:CO%=WC%:GOSUB 1600:GOTO 1515
1514 CH%=32:A%=OP%:B%=TR%-1:CO%=0:GOSUB 1600
1515 IF BR%=OB% THEN 1519
1516 IF BR%>OB% THEN 1518
1517 CH%=46:A%=BR%+1:B%=OB%:CO%=8:GOSUB 1600:GOTO 1519
1518 CH%=WG%:A%=OB%+1:B%=BR%:CO%=WC%:GOSUB 1600
1519 LP%(J%)=TR%:LB%(J%)=BR%:LH%(J%)=HT%:LW%(J%)=WC%:RETURN

1600 REM COLOR+CHAR ROWS [A%..B%] CO%,CH% (Q% color, Q1% screen, +40/row)
1601 IF A%<1 THEN A%=1
1602 IF B%>23 THEN B%=23
1603 IF A%>B% THEN RETURN
1604 Q%=CB%+A%*40:Q1%=1024+C1%+A%*40:RC%=B%-A%+1
1605 POKE Q%,CO%:POKE Q1%,CH%:Q%=Q%+40:Q1%=Q1%+40:RC%=RC%-1:IF RC% THEN 1605
1606 RETURN
1607 REM RECOLOR+CHAR ROWS [A%..B%] CO%,CH% (POKE +40/row)
1608 IF A%<1 THEN A%=1
1609 IF B%>23 THEN B%=23
1610 IF A%>B% THEN RETURN
1611 Q%=CB%+A%*40:Q1%=1024+C1%+A%*40:RC%=B%-A%+1
1612 POKE Q%,CO%:POKE Q1%,CH%:Q%=Q%+40:Q1%=Q1%+40:RC%=RC%-1:IF RC% THEN 1612
1613 RETURN
1614 REM FIRST FRAME col C1%: full color+char draw
1615 TT%=12-INT(HT%/2):TP%=TT%:BT%=TT%+HT%-1
1616 IF TP%<6 THEN TP%=6
1617 IF BT%>17 THEN BT%=17
1618 IF TP%>BT% THEN TP%=BT%
1619 TR%=TP%:BR%=BT%
1620 CH%=32:A%=1:B%=TR%-1:CO%=0:GOSUB 1600
1621 CH%=WG%:A%=TR%:B%=BR%:CO%=WC%:GOSUB 1600
1622 CH%=46:A%=BR%+1:B%=23:CO%=8:GOSUB 1600
1623 GOTO 1519

