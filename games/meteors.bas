1400 REM INPUT: DM%=1 AI AUTOPLAY, ELSE HUMAN KBD
1401 K%=PEEK(197):POKE 198,0:SF%=PEEK(653) AND 1
1402 IF K%=2 THEN IF SF% THEN K%=10
