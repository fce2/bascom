2000 REM ERASE ROW RY OF METEOR N
2001 IF RY<1 THEN RETURN
2002 IF RY>23 THEN RETURN
2003 FOR C=0 TO WW(N)-1:POKE 1024+RY*40+WC%(N)+C,32:NEXT C
2004 RETURN

2100 REM DRAW ROW RY OF METEOR N
2101 IF RY<1 THEN RETURN
2102 IF RY>23 THEN RETURN
2103 K=RY-WR(N)+WH(N)-1:KR=GB%(N)+K*WW(N)
2104 FOR C=0 TO WW(N)-1:MC=GT%(KR+C):POKE 1024+RY*40+WC%(N)+C,MC:POKE 55296+RY*40+WC%(N)+C,8:NEXT C
2105 RETURN

2200 REM SPAWN METEOR
2201 FOR N=0 TO 7
2202 IF WR(N)>=0 THEN 2206
2203 Z%=INT(RND(1)*7):WW(N)=SW(Z%):WH(N)=SH(Z%):GB%(N)=SB%(Z%)
2204 WC%(N)=INT(RND(1)*(41-WW(N))):WR(N)=WH(N):FOR RY=1 TO WH(N):GOSUB 2100:NEXT RY
2205 RETURN
2206 NEXT N
2207 RETURN

2300 REM AI AUTOPLAY: EARLY-DODGE IMMINENT METEORS BY CENTER; ELSE CREEP TO MID
2301 K%=64
2302 PC=X+PW/2
2303 DR=-1:DN=-1
2304 FOR N=0 TO 7
2305 IF WR(N)<0 THEN 2311
2306 IF WR(N)<15 THEN 2311
2307 MT=WC%(N)+WW(N)/2
2308 MD=ABS(MT-PC)
2309 IF DR<0 THEN DR=MD:DN=N:GOTO 2311
2310 IF MD<DR THEN DR=MD:DN=N
2311 NEXT N
2312 IF DR<0 THEN 2316
2313 MC=WC%(DN)+WW(DN)/2
2314 IF MC<PC THEN K%=18:RETURN
2315 K%=10:RETURN
2316 REM IDLE: CREEP TOWARD CENTER COL 20
2317 IF PC<19 THEN K%=18:RETURN
2318 IF PC>21 THEN K%=10:RETURN
2319 K%=64:RETURN

