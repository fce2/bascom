5 REM! TSB
6 REM! GOS TASKS 5
10 REM gos_tsb_swarm -- 4 concurrent fireworks, one per screen quadrant, cooperative TYIELD
20 REM 16 particles in shared arrays; each task owns 4 disjoint indices (TL 0-3 TR 4-7 BL 8-11 BR 12-15)
30 REM gravity arcs each particle; relaunch from quadrant floor when it falls out. erase via f=0 (clear):
40 REM FL(i) gates first-frame (skip erase until a particle has been drawn once). PLOT can't erase -> 1x1 BLOCK
50 HIRES 1,0:COLOUR 1,0
60 DIM PX(15),PY(15),VX(15),VY(15),OX(15),OY(15),FL(15)
70 FOR I=0 TO 15:PX(I)=40+INT(RND(1)*240):PY(I)=50+INT(RND(1)*100):VX(I)=INT(RND(1)*3)-1:VY(I)=-5:OX(I)=PX(I):OY(I)=PY(I):FL(I)=0:NEXT I
80 TASYNC 1000:TASYNC 2000:TASYNC 3000:TASYNC 4000
100 TYIELD:GOTO 100
1000 REM task1: firework TL, particles 0-3, x 1..158 y 0..95, launch from y=95
1005 P1=0
1010 IF P1>3 THEN P1=0
1015 IF FL(P1)=1 THEN BLOCK OX(P1),OY(P1),OX(P1),OY(P1),0
1020 PY(P1)=PY(P1)+VY(P1):VY(P1)=VY(P1)+1:PX(P1)=PX(P1)+VX(P1)
1030 IF PY(P1)>95 OR PX(P1)<1 OR PX(P1)>158 THEN PX(P1)=70+INT(RND(1)*20):PY(P1)=95:VX(P1)=INT(RND(1)*5)-2:VY(P1)=-8-INT(RND(1)*4)
1040 BLOCK PX(P1),PY(P1),PX(P1),PY(P1),1:OX(P1)=PX(P1):OY(P1)=PY(P1):FL(P1)=1
1050 P1=P1+1:TYIELD:GOTO 1010
2000 REM task2: firework TR, particles 4-7, x 161..318 y 0..95
2005 P2=4
2010 IF P2>7 THEN P2=4
2015 IF FL(P2)=1 THEN BLOCK OX(P2),OY(P2),OX(P2),OY(P2),0
2020 PY(P2)=PY(P2)+VY(P2):VY(P2)=VY(P2)+1:PX(P2)=PX(P2)+VX(P2)
2030 IF PY(P2)>95 OR PX(P2)<161 OR PX(P2)>318 THEN PX(P2)=230+INT(RND(1)*20):PY(P2)=95:VX(P2)=INT(RND(1)*5)-2:VY(P2)=-8-INT(RND(1)*4)
2040 BLOCK PX(P2),PY(P2),PX(P2),PY(P2),1:OX(P2)=PX(P2):OY(P2)=PY(P2):FL(P2)=1
2050 P2=P2+1:TYIELD:GOTO 2010
