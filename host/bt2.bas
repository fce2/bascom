100 REM  *** SIMPLE RAYTRACER BY MARCO64  14.06.2008 *** ANIMATED ***
200 DIM KX(10),KY(10),KZ(10),KR(10),OX(10),OZ(10)
201 AK = 3 - 1 : CA = 0
202 OX(0)= 3
203 KY(0)= 9
204 OZ(0)= 50
205 KR(0)= 9
206 OX(1)= - 12
207 KY(1)= 7
208 OZ(1)= 80
209 KR(1)= 7
210 OX(2)= - 3
211 KY(2)= 3
212 OZ(2)= 35
213 KR(2)= 3
214 BX = 0
215 BY = 5
216 BZ = - 17
217 BE = 25
218 LX = - 50
219 LY = 300
220 LZ = 50
221 GB = 10
222 POKE 53272,11
223 POKE 53265,59
224 POKE 56576,148
250 FR = 0
260 REM ---- animation loop: sphere 0 orbits; cursor L/R turntable scene ----
261 OX(0)= 3 + 15 * SIN (FR*0.1)
262 OZ(0)= 50 + 15 * (COS (FR*0.1) - 1)
263 KY(0)= 9 + 3 * SIN (FR*0.2)
264 CC = COS (CA) : SS = SIN (CA)
265 FOR I = 0 TO AK : KX(I)= OX(I)*CC - (OZ(I)-50)*SS : KZ(I)= 50 + OX(I)*SS + (OZ(I)-50)*CC : NEXT I
266 IF CF = 0 THEN 300
267 GOTO 304
300 FOR I = 1024 TO 2023
301 POKE 48128 + I,15
302 POKE 54272 + I,0
303 NEXT :CF = 1
304 FOR PB =  0 TO 8000
306 ZW = PB AND 7
307 Y = INT (PB / 320)* 8 + ZW
308 ZW = INT (PB / 8)
309 ZX = (ZW - INT (ZW / 40)* 40)* 8
310 PW = 0
400 FOR PX = 0 TO 7
401 X = ZX + PX
402 ZW = GB / 320
403 RX = X * ZW - GB / 2
404 RY = - Y * ZW + 200 / 2 * ZW
405 RZ = BE
406 ZW = SQR (RX * RX + RY * RY + RZ * RZ)
407 RX = RX / ZW
408 RY = RY / ZW
409 RZ = RZ / ZW
410 OX = BX
411 OY = BY
412 OZ = BZ
413 RD = 0
500 GOSUB 1000
501 ON - ((OY + T * RY)> 0)GOTO 600
502 LA = - OY / RY
503 SX = OX + LA * RX
504 SY = 0
505 SZ = OZ + LA * RZ
506 ZW = (INT (SX / 5)AND 1)+ (INT (SZ / 5)AND 1)
507 FA = (ZW = 1)+ 1
508 OX = SX
509 OY = SY
510 OZ = SZ
511 RX = OX + LX
512 RY = OY + LY
513 RZ = OZ + LZ
514 GOSUB 1000
515 ON - (K = - 1)GOTO 900
516 FA = ((X AND 1)< > (Y AND 1))+ 1
517 GOTO 900
600 IF K = - 1 THEN FA = 0:GOTO 900
700 X1 = KX(K)* RX + KY(K)* RY + KZ(K)* RZ
701 X2 = OX * RX + OY * RY + OZ * RZ
702 X3 = RX * RX + RY * RY + RZ * RZ
703 LA = (X1 - X2)/ X3
704 F1 = (OX + LA * RX)- KX(K)
705 F2 = (OY + LA * RY)- KY(K)
706 F3 = (OZ + LA * RZ)- KZ(K)
707 D = SQR (F1 * F1 + F2 * F2 + F3 * F3)
708 IF (KR(K)* .95 < D)THEN FA = 1:GOTO 900
710 RD = RD + 1: IF RD > 8 THEN FA = 1:GOTO 900
800 OX = OX + T * RX
801 OY = OY + T * RY
802 OZ = OZ + T * RZ
803 NX = KX(K)- OX
804 NY = KY(K)- OY
805 NZ = KZ(K)- OZ
806 ZW = NX * RX + NY * RY + NZ * RZ
807 RX = RX - 2 * ZW * NX
808 RY = RY - 2 * ZW * NY
809 RZ = RZ - 2 * ZW * NZ
810 ZW = SQR (RX * RX + RY * RY + RZ * RZ)
811 RX = RX / ZW
812 RY = RY / ZW
813 RZ = RZ / ZW
814 GOTO 500
900 PW = PW * 2 + FA
901 NEXT PX
902 POKE 57344 + PB,PW
903 NEXT PB
904 FR = FR + 1
905 GET A$
906 IF A$ = CHR$(29) THEN CA = CA + 0.1 : GOTO 260
907 IF A$ = CHR$(157) THEN CA = CA - 0.1 : GOTO 260
908 IF A$ = CHR$(145) THEN BY = BY + 1 : GOTO 260
909 IF A$ = CHR$(17) THEN BY = BY - 1 : GOTO 260
910 IF A$ = "w" OR A$ = "W" THEN BZ = BZ + 1 : GOTO 260
911 IF A$ = "s" OR A$ = "S" THEN BZ = BZ - 1 : GOTO 260
912 IF A$ = "a" OR A$ = "A" THEN BX = BX - 1 : GOTO 260
913 IF A$ = "d" OR A$ = "D" THEN BX = BX + 1 : GOTO 260
914 IF A$ = "x" OR A$ = "X" THEN 920
915 GOTO 260
920 END
1000 K = - 1
1001 T = 99999
1002 FOR I = 0 TO AK
1003 ZW = RX * RX + RY * RY + RZ * RZ
1004 P = (2 * (RX * (OX - KX(I))+ RY * (OY - KY(I))+ RZ * (OZ - KZ(I))))/ ZW
1005 Q = ((OX - KX(I))* (OX - KX(I))+ (OY - KY(I))* (OY - KY(I))+ (OZ - KZ(I))* (OZ - KZ(I))- KR(I)* KR(I))/ ZW
1006 Z1 = - P / 2
1007 Z2 = ((P * P)/ 4 - Q)
1008 IF Z2 < 0 THEN NEXT :RETURN
1100 WU = SQR (Z2)
1101 X1 = Z1 + WU
1102 X2 = Z1 - WU
1103 Z0 = - ((X1 > .001)AND (X1 < T))
1104 Z1 = - Z0 + 1
1105 K = Z0 * I + Z1 * K
1106 T = Z0 * X1 + Z1 * T
1107 Z0 = - ((X2 > .001)AND (X2 < T))
1108 Z1 = - Z0 + 1
1109 K = Z0 * I + Z1 * K
1110 T = Z0 * X2 + Z1 * T
1111 NEXT
1112 RETURN