10 PI = 3.141593
20 N = 64
30 ST = 2 * PI / N
40 POKE DDRB, 32
50 FOR I = 0 TO N - 1
60 A = I * ST
70 V = SIN(A)
80 B% = INT((V + 1) * 127.5)
90 FOR R = 1 TO 60
100 FOR K = 0 TO 255
110 IF K < B% THEN POKE PORTB, 32
120 IF K >= B% THEN POKE PORTB, 0
130 NEXT K
140 NEXT R
150 NEXT I
160 GOTO 50
